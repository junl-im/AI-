# Web
# Local Vite development uses the /api proxy automatically.
# Static hosting such as GitHub Pages needs a separately deployed HTTPS API URL.
# GitHub Actions repository variable (one or more HTTPS endpoints):
# SORION_PUBLIC_API_BASE_URLS=https://voice-a.example.com,https://voice-b.example.com
# A phone cannot reach the PC through localhost. The app auto-discovers same-origin/deploy
# candidates and persists the last successful URL; there is no user-facing API address input.
VITE_API_BASE_URL=
VITE_API_BASE_URLS=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# API
SORION_ENVIRONMENT=development
SORION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://junl-im.github.io
SORION_DEFAULT_TTS_ENGINE=auto
# free-only: 유료 API Adapter를 등록하거나 자동 호출하지 않습니다.
# balanced: 운영자가 서버 Secret과 과금 한도를 준비한 경우에만 선택합니다.
SORION_ENGINE_COST_POLICY=free-only
SORION_TTS_ENGINE_ORDER=cosyvoice3,melo,system,naver-clova,google-chirp3-hd,azure-speech,elevenlabs-v3,mock
SORION_ENGINE_FAILURE_THRESHOLD=2
SORION_ENGINE_COOLDOWN_SECONDS=30
SORION_ALLOW_MOCK_ENGINE=true
SORION_ENABLE_MELO_TTS=true
SORION_MELO_DEVICE=auto
SORION_ENABLE_SYSTEM_TTS=true
SORION_SYSTEM_TTS_VOICE=
SORION_GENERATION_TIMEOUT_SECONDS=75
SORION_MAX_CONCURRENT_GENERATIONS=1
SORION_JOB_STORE_PATH=.sorion/jobs.sqlite3
SORION_JOB_CLAIM_TTL_SECONDS=120
SORION_JOB_RESULT_TTL_MINUTES=30
SORION_JOB_HISTORY_TTL_HOURS=24
SORION_JOB_POLL_INTERVAL_SECONDS=0.1
SORION_AUDIO_TTL_MINUTES=30
SORION_AUDIO_DIRECTORY=.sorion/audio

# Korean text preprocessing
SORION_MAX_SEGMENT_CHARS=180

# Voice clone · local first
SORION_VOICE_CLONE_DIRECTORY=.sorion/voice-clones
SORION_VOICE_CLONE_TTL_DAYS=7
SORION_VOICE_CLONE_MAX_FILE_BYTES=26214400
SORION_COSYVOICE_WORKER_URL=
SORION_COSYVOICE_WORKER_TIMEOUT_SECONDS=2.5
SORION_COSYVOICE_WORKER_JOB_TIMEOUT_SECONDS=45
SORION_COSYVOICE_TTS_REFERENCE_PATH=
SORION_COSYVOICE_TTS_PROFILE_ID=sorion-korean-reference
SORION_WORKER_SERVICE_TOKEN=
SORION_WORKER_SIGNATURE_SECRET=

# Optional metered Korean TTS credentials. free-only에서는 등록하지 않습니다.
# Server only; never expose these to Vite/Web.
SORION_NAVER_CLOVA_CLIENT_ID=
SORION_NAVER_CLOVA_CLIENT_SECRET=
SORION_NAVER_CLOVA_SPEAKER=nara
SORION_GOOGLE_TTS_API_KEY=
SORION_GOOGLE_TTS_VOICE=ko-KR-Chirp3-HD-Aoede
SORION_AZURE_SPEECH_KEY=
SORION_AZURE_SPEECH_REGION=koreacentral
SORION_AZURE_SPEECH_VOICE=ko-KR-SunHiNeural
SORION_ELEVENLABS_API_KEY=
SORION_ELEVENLABS_VOICE_ID=
SORION_ELEVENLABS_MODEL_ID=eleven_v3
SORION_CLOUD_TTS_TIMEOUT_SECONDS=45
SORION_PUBLIC_RATE_LIMIT_PER_MINUTE=120
# 개발 중 휴대폰에서 PC LAN API를 호출할 때 필요한 Private Network preflight 허용
SORION_ALLOW_PRIVATE_NETWORK=true
SORION_AUDIT_LOG_PATH=.sorion/audit/api.jsonl

# CosyVoice Worker
SORION_WORKER_ENVIRONMENT=development
SORION_WORKER_OUTPUT_PATH=.sorion/worker
SORION_WORKER_MODEL_PATH=
SORION_WORKER_ADAPTER_MODULE=app.adapters.cosyvoice3
SORION_WORKER_DEVICE=auto
SORION_WORKER_ALLOW_CPU=false
SORION_WORKER_MIN_VRAM_MB=8192
SORION_WORKER_REQUIRED_MODEL_FILES=
SORION_WORKER_MAX_CONCURRENT_JOBS=1
SORION_WORKER_MAX_SAMPLE_BYTES=26214400
SORION_WORKER_JOB_TTL_MINUTES=60
SORION_WORKER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SORION_WORKER_AUTH_TTL_SECONDS=30
SORION_WORKER_RATE_LIMIT_PER_MINUTE=240
SORION_WORKER_AUDIT_PATH=.sorion/worker/audit.jsonl
