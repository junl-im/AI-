# Web · GitHub Pages / Firebase Hosting (Spark)
# Firebase VITE_* values below are public browser configuration, not Admin SDK secrets.
# Static hosting cannot execute the Python Voice API. On desktop, the app automatically
# probes the local free runtime at 127.0.0.1:8000. On mobile it uses Browser Speech.
# Optional self-hosted free API candidates may be injected at build/runtime without a UI.
VITE_API_BASE_URL=
VITE_API_BASE_URLS=
# Optional manual deployment revision. GitHub Actions uses GITHUB_SHA automatically.
VITE_BUILD_REVISION=
VITE_FIREBASE_API_KEY=AIzaSyDAwQhnPTFQJCRuPbIrntrR9Eo4d2hWnj4
VITE_FIREBASE_AUTH_DOMAIN=device-streaming-96b2272c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=device-streaming-96b2272c
VITE_FIREBASE_STORAGE_BUCKET=device-streaming-96b2272c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=443705861764
VITE_FIREBASE_APP_ID=1:443705861764:web:6b40c902871dfbc7d184d1

# API · free local engines only
SORION_ENVIRONMENT=development
SORION_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://junl-im.github.io
SORION_DEFAULT_TTS_ENGINE=auto
SORION_TTS_ENGINE_ORDER=cosyvoice3,melo,system,mock
SORION_ENGINE_FAILURE_THRESHOLD=2
SORION_ENGINE_COOLDOWN_SECONDS=30
SORION_ALLOW_MOCK_ENGINE=true
SORION_ENABLE_MELO_TTS=true
SORION_MELO_DEVICE=auto
SORION_ENABLE_SYSTEM_TTS=true
SORION_SYSTEM_TTS_VOICE=
SORION_GENERATION_TIMEOUT_SECONDS=75
SORION_MAX_CONCURRENT_GENERATIONS=1
SORION_JOB_STORE_PATH=.sorion/jobs.sqlite3
SORION_JOB_CLAIM_TTL_SECONDS=120
SORION_JOB_RESULT_TTL_MINUTES=30
SORION_JOB_HISTORY_TTL_HOURS=24
SORION_JOB_POLL_INTERVAL_SECONDS=0.1
SORION_AUDIO_TTL_MINUTES=30
SORION_AUDIO_DIRECTORY=.sorion/audio
# Partial audio URLs are short-lived and HMAC-signed. Production must use a stable secret.
SORION_SEGMENT_URL_TTL_SECONDS=900
SORION_SEGMENT_URL_SIGNING_SECRET=
# Only direct peers inside these CIDRs may supply X-Forwarded-* headers.
SORION_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
SORION_MAX_SEGMENT_CHARS=180
SORION_PUBLIC_RATE_LIMIT_PER_MINUTE=120
SORION_ALLOW_PRIVATE_NETWORK=true
SORION_AUDIT_LOG_PATH=.sorion/audit/api.jsonl

# Voice clone · local CosyVoice Worker
SORION_VOICE_CLONE_DIRECTORY=.sorion/voice-clones
SORION_VOICE_CLONE_TTL_DAYS=7
SORION_VOICE_CLONE_MAX_FILE_BYTES=26214400
SORION_COSYVOICE_WORKER_URL=
SORION_COSYVOICE_WORKER_TIMEOUT_SECONDS=2.5
SORION_COSYVOICE_WORKER_JOB_TIMEOUT_SECONDS=45
SORION_COSYVOICE_WORKER_PROBE_INTERVAL_SECONDS=15
SORION_COSYVOICE_TTS_REFERENCE_PATH=
SORION_COSYVOICE_TTS_PROFILE_ID=sorion-korean-reference
SORION_COSYVOICE_PRESET_DIRECTORY=
# START_ENGINE.cmd는 비어 있을 때 프로젝트의 voice-presets 폴더를 자동 연결합니다.
SORION_WORKER_SERVICE_TOKEN=
SORION_WORKER_SIGNATURE_SECRET=

# CosyVoice Worker
SORION_WORKER_ENVIRONMENT=development
SORION_WORKER_OUTPUT_PATH=.sorion/worker
SORION_WORKER_MODEL_PATH=
SORION_WORKER_MODEL_MANIFEST_PATH=
SORION_WORKER_REQUIRE_MODEL_MANIFEST=true
SORION_WORKER_MODEL_LICENSE_ACCEPTED=false
SORION_WORKER_ADAPTER_MODULE=app.adapters.cosyvoice3
SORION_WORKER_DEVICE=auto
SORION_WORKER_ALLOW_CPU=false
SORION_WORKER_MIN_VRAM_MB=8192
SORION_WORKER_MIN_DISK_FREE_MB=1024
SORION_WORKER_REQUIRED_MODEL_FILES=
SORION_WORKER_MAX_CONCURRENT_JOBS=1
SORION_WORKER_MAX_SAMPLE_BYTES=26214400
SORION_WORKER_JOB_TTL_MINUTES=60
SORION_WORKER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SORION_WORKER_AUTH_TTL_SECONDS=30
SORION_WORKER_RATE_LIMIT_PER_MINUTE=240
SORION_WORKER_AUDIT_PATH=.sorion/worker/audit.jsonl

# Optional local Faster Whisper verification
SORION_FASTER_WHISPER_MODEL=small
SORION_FASTER_WHISPER_DEVICE=auto
SORION_FASTER_WHISPER_COMPUTE_TYPE=default
SORION_STT_DIRECTORY=.sorion/stt
SORION_DEVICE_BENCHMARK_PATH=.sorion/quality/device-benchmarks.jsonl
SORION_WORKER_TELEMETRY_PATH=.sorion/quality/worker-synthesis-telemetry.jsonl
SORION_VOICE_REVIEW_APPROVAL_PATH=.sorion/quality/voice-review-approvals.jsonl
# Optional local HMAC trust key. Never commit or ship the actual secret.
SORION_VOICE_REVIEW_SIGNING_SECRET=
SORION_VOICE_REVIEW_SIGNING_KEY_ID=local-review-key
# Previous/grace trust keys as a JSON object. Keep actual secrets outside Git and release ZIPs.
SORION_VOICE_REVIEW_TRUSTED_KEYS_JSON={}
# Cross-process approval/resign/rollback lock acquisition timeout.
SORION_VOICE_REVIEW_LOCK_TIMEOUT_SECONDS=10
# Durable SQLite writer lease and fencing token for multiple API processes.
SORION_VOICE_REVIEW_WRITER_LEASE_PATH=.sorion/quality/voice-review-writer.sqlite3
SORION_VOICE_REVIEW_WRITER_LEASE_SECONDS=30
# Approval preview/apply/history/resign/renewal/rollback: loopback can stay blank; LAN/remote requires 32+ chars.
SORION_VOICE_REVIEW_OPERATOR_TOKEN=
SORION_VOICE_REVIEW_ALLOW_LOOPBACK_WITHOUT_TOKEN=true
SORION_STT_MAX_FILE_BYTES=104857600

# Quality evidence (local JSONL only)
SORION_STT_COMPARISON_PATH=.sorion/quality/stt-regeneration-comparisons.jsonl
SORION_EXPORT_SOAK_PATH=.sorion/quality/export-soak.jsonl
