{
  "name": "sorion-ai",
  "version": "0.9.3-alpha.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ci": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "test:api": "python -m pytest services/api/tests",
    "quality:rules": "node scripts/check-project-rules.mjs",
    "cleanup:stale-brand": "node scripts/remove-stale-brand-assets.mjs",
    "quality:web-manifest": "node scripts/check-web-toolchain.mjs --manifest-only",
    "quality:web-toolchain": "node scripts/check-web-toolchain.mjs",
    "quality": "npm run quality:web-toolchain && npm run quality:rules && npm run quality:free-only && npm run quality:engine-blueprint && npm run quality:model-onboarding && npm run lint && npm run typecheck && npm run test && npm run test:api && npm run test:worker",
    "dev:web": "npm run dev",
    "build:web": "npm run build",
    "test:web": "npm run test",
    "lint:web": "npm run lint",
    "typecheck:web": "npm run typecheck",
    "dev:api": "node scripts/start-api.mjs",
    "test:worker": "python -m pytest services/worker/tests",
    "dev:worker": "node scripts/start-worker.mjs",
    "runtime:config": "node scripts/write-runtime-config.mjs",
    "quality:free-only": "node scripts/check-free-only-boundary.mjs",
    "dev:free": "node scripts/start-free-runtime.mjs",
    "quality:engine-blueprint": "node scripts/check-engine-blueprint.mjs",
    "model:manifest": "python services/worker/scripts/model_manifest.py",
    "quality:model-onboarding": "node scripts/check-model-onboarding.mjs"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "firebase": "11.4.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.15.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.22.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "16.0.0",
    "jsdom": "26.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "8.2.0"
  }
}
