{
  "name": "sorion-ai",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "python -m pytest services/api/tests",
    "quality:rules": "node scripts/check-project-rules.mjs",
    "quality": "npm run quality:rules && npm run lint && npm run typecheck && npm run test && npm run test:api && npm run test:worker",
    "dev:web": "npm run dev",
    "build:web": "npm run build",
    "test:web": "npm run test",
    "lint:web": "npm run lint",
    "typecheck:web": "npm run typecheck",
    "dev:api": "node scripts/start-api.mjs",
    "test:worker": "python -m pytest services/worker/tests",
    "dev:worker": "node scripts/start-worker.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "firebase": "^11.4.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.1.0"
  }
}
