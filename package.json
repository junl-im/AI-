    "quality:voice-preset-evidence": "node scripts/check-voice-preset-evidence.mjs",
    "quality:voice-review-sync": "node scripts/check-voice-review-sync.mjs",
    "quality:signed-review-benchmark": "node scripts/check-signed-review-benchmark.mjs",
    "quality:voice-review-operator": "node scripts/check-voice-review-operator-gate.mjs",
    "quality:runtime-update": "node scripts/check-runtime-update-guard.mjs",
    "quality:seamless-engine": "node scripts/check-seamless-engine-runtime.mjs",
    "quality:trust-key-renewal": "node scripts/check-trust-key-renewal.mjs",
    "version:set": "node scripts/set-app-version.mjs",
    "quality:version-sync": "node scripts/check-version-sync.mjs",
    "quality:benchmark-audit": "node scripts/check-benchmark-privacy-audit.mjs",
    "quality:long-run-writer": "node scripts/check-long-run-writer-safety.mjs",
    "quality:playback-flow": "node scripts/check-playback-control-flow.mjs",
    "quality:compatibility": "node scripts/check-quality-gate-compatibility.mjs",
    "quality:always-on-workspace": "node scripts/check-always-on-preset-pc-layout.mjs",
    "quality:operator-baselines": "node scripts/check-approval-modularization-operator-baseline.mjs",
    "quality:recovery-soak": "node scripts/check-recovery-soak-managed-lock.mjs",
    "quality:studio-ux": "node scripts/check-studio-playback-timeline-ux.mjs",
